# The build always compiles the bcm2837 machine master, and that config keeps Apple's
# arm64 assembly and pmap off (nos_arm_asm, nos_arm_pmap unset), because Apple's own
# SoCs link them from the KDK's closed lib<SOC>.os.<CONFIG>.a. There is no such library
# for SM8550, so the kernel linked with 11 undefined symbols:
#
#   set_mmu_ttb, set_mmu_ttb_alternate, set_tcr, start_cpu, resume_idle_cpu
#   (osfmk/arm64/start.s, locore.s), pmap_zero_part_page, vm_first_phys,
#   vm_last_phys, vm_footprint_suspend_allowed (osfmk/arm/pmap/pmap.c),
#   thread_bootstrap_return (osfmk/arm64/locore.s), sweet_sample_task.
#
# Turning the two options on builds those files from the source tree. They are the
# open-source implementations, which is what the sweet configuration in this series
# already assumes (0006), and what 0007/0008 prepare for: Apple-internal headers are
# stubbed and kpc has a PMU-less stand-in. Apple's own AMCC sources stay out through
# the apple_amcc option this patch also declares.

--- a/config/MASTER
+++ b/config/MASTER
@@ -322,6 +322,8 @@
 # Compile XNU with PPL support.
 options   CONFIG_PMAP_PPL			# <config_pmap_ppl>
 
+options   CONFIG_APPLE_AMCC			# <apple_amcc>
+
 options   NOS_ARM_ASM			# <nos_arm_asm>
 options   NOS_ARM_PMAP			# <nos_arm_pmap>
 
--- a/config/MASTER.arm64.bcm2837
+++ b/config/MASTER.arm64.bcm2837
@@ -94,3 +94,8 @@
 options   CONFIG_KERNEL_INTEGRITY		# <kernel_integrity>
 options   CONFIG_UBSAN_MINIMAL		# <ubsan_minimal>
 options   CONFIG_KERNEL_TBI	# <kernel_tbi>
+
+# fuxi: the SoC is not Apple silicon, so the arm64 assembly and the pmap come from
+# the open sources instead of the KDK closed lib<SOC>.os.<CONFIG>.a.
+options   NOS_ARM_ASM			# <nos_arm_asm>
+options   NOS_ARM_PMAP			# <nos_arm_pmap>
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
@@ -25,8 +25,8 @@
 osfmk/arm64/WKdmData.s		standard
 osfmk/arm64/lz4_decode_arm64.s  standard
 osfmk/arm64/lz4_encode_arm64.s  standard
-osfmk/arm64/amcc_rorgn_ppl.c optional nos_arm_asm config_pmap_ppl
-osfmk/arm64/amcc_rorgn_common.c optional nos_arm_asm
+osfmk/arm64/amcc_rorgn_ppl.c optional nos_arm_asm config_pmap_ppl apple_amcc
+osfmk/arm64/amcc_rorgn_common.c optional nos_arm_asm apple_amcc
 osfmk/arm64/bcopy.s standard
 osfmk/arm64/bzero.s standard
 osfmk/arm/caches.c		standard
