# Portability fixes for a newer clang than the one this kernel was written for.
#
# clang 20 and later reject two things this tree does freely, which Apple's clang 15 --
# the one that built the iOS 16 kernel -- only warned about:
#
#   - initialising a pointer from &array[0] of another element type (nfs_serv.c): a
#     stack uio buffer is an array of uint64_t for alignment and is handed out as char*.
#   - IODeleteData() with a void* operand: the kalloc_type assert wants the pointed-to
#     type, so the two sites that keep the reference as void* now cast it to a typed
#     local first. The macro's os_ptr_load_and_erase() then clears that local instead of
#     the member, so both sites clear the member explicitly: same memory, same state.
#
# Neither changes behaviour: the nfs cast is the same pointer, and the two IOUserServer
# sites free exactly the memory they freed before.

--- a/bsd/nfs/nfs_serv.c
+++ b/bsd/nfs/nfs_serv.c
@@ -770,7 +770,7 @@
 	mbuf_t mpath, mp;
 	uio_t auio = NULL;
 	UIO_STACKBUF(uio_buf, 4);
-	char *uio_bufp = &uio_buf[0];
+	char *uio_bufp = (char *)&uio_buf[0];
 	int uio_buflen = UIO_SIZEOF(4);
 
 	error = 0;
--- a/iokit/Kernel/IOUserServer.cpp
+++ b/iokit/Kernel/IOUserServer.cpp
@@ -1331,7 +1331,9 @@
 	OSSafeReleaseNULL(sym);
 	OSSafeReleaseNULL(inst);
 	if (reference) {
-		IODeleteData(reference, uint8_t, referenceSize);
+		uint8_t *data = (uint8_t *)reference;
+		reference = NULL;
+		IODeleteData(data, uint8_t, referenceSize);
 	}
 
 	return ret;
@@ -1384,8 +1386,10 @@
 		OSSafeReleaseNULL(ivars->typeName);
 		OSSafeReleaseNULL(ivars->userServer);
 		if (ivars->reference) {
+			uint8_t *data = (uint8_t *)ivars->reference;
 			assert(ivars->referenceSize > 0);
-			IODeleteData(ivars->reference, uint8_t, ivars->referenceSize);
+			ivars->reference = NULL;
+			IODeleteData(data, uint8_t, ivars->referenceSize);
 		}
 		IOSafeDeleteNULL(ivars, OSAction_IVars, 1);
 	}
