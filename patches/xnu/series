#   0020-stage-bearssl.sh    7cb12c6b2e927289be24a0cc8a4da71072500e8138a0c47d862b0f6571c0f37f
#   0026-stage-hfs.sh        40e0504ad4097be017f1c60efe99ea263a498f8c0ca2f8914b2e093d85710a5b

